#### joe made this: http://goel.io/joe

#####=== Python ===#####

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
# Anchored to the repo root: unanchored, these hid any lib/, build/ or var/
# directory anywhere in the tree (script/lib/, a lua/<mod>/lib/).
.Python
/env/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
/*.manifest
/*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Neovim
..nvimrc-rplugin~

# dein.vim
dein/

# vim-plug
plugged/

# NeoBundle
bundle/

# Neovim ShaDa
shada/
undo/

test/vint

# packaer.nvim
plugin/packer_compiled.lua

# macOS Finder metadata
.DS_Store

# oh-my-claudecode runtime state; .omc/skills/ holds project-scoped skills
# and is committed. The global excludes file ignores .omc/ as a directory,
# and git never descends into an excluded directory, so un-ignore the
# directory itself before ignoring its contents.
!/.omc/
/.omc/*
!/.omc/skills/
